# ── Cloud model (default) ─────────────────────────────────────────────
# Any OpenAI-compatible endpoint works. DeepSeek shown as the default.
DEEPSEEK_API_KEY=your_deepseek_api_key
# openai (default) or codex; codex needs CLI login instead of an API key.
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_THINKING_TYPE=enabled
LLM_REASONING_EFFORT=high
LLM_TEMPERATURE=0.7
PORT=8787

# ── ChatGPT subscription via official Codex CLI (optional) ──
# Install current @openai/codex and run codex login as the backend OS user.
# Requires --ephemeral, --ignore-user-config, and --ignore-rules support.
# LLM_PROVIDER=codex
# CODEX_MODEL=gpt-6.1-sol
# CODEX_REASONING_EFFORT=medium
# CODEX_CONCURRENCY=2
# CODEX_TIMEOUT_MS=600000
# CODEX_MIN_TIMEOUT_MS=180000
# CODEX_BIN=/absolute/path/to/codex-or-codex.js
# No LLM_API_KEY / DEEPSEEK_API_KEY required. No temperature control.
# Slower: each call is an agent run with ~30k-token overhead (varies).
# Usage counts against your ChatGPT plan; personal local use only,
# not for production or multi-user service. Optional research is separate;
# set DEEPSEEK_SEARCH=off if DeepSeek search has no balance.

# ── Local network exposure (safe defaults) ──
# Keep the backend on loopback unless you deliberately deploy it on a LAN.
HOST=127.0.0.1
# Default browser origins are http://localhost:51773 and
# http://127.0.0.1:51773. Only override this for an intentional deployment;
# use exact comma-separated http(s) origins. Wildcard (*) is never accepted.
# CORS_ORIGINS=http://192.168.1.20:51773

# ── Broad web research (optional) ─────────────────────────────────────
# Google News RSS plus Hacker News article/comment search work without
# a key. Add an Exa key to broaden the default search to more websites and
# public discussion pages. Existing Agent-Reach/mcporter remains a fallback.
# EXA_API_KEY=your_exa_api_key
# DeepSeek Search runs alongside Exa / Agent-Reach when a DeepSeek key is set.
# Uses LLM_API_KEY before DEEPSEEK_API_KEY when LLM_BASE_URL is DeepSeek;
# otherwise only the dedicated DEEPSEEK_API_KEY is used.
# DEEPSEEK_SEARCH=off
# Optional HTTPS search endpoint override (receives the DeepSeek key).
# DEEPSEEK_SEARCH_URL=https://api.deepseek.com/v1/tools/search

# ── International network proxy (optional) ───────────────────────────
# If some overseas feeds are unreachable on your network, point these at your
# local proxy and restart. Node.js 24.14+ applies .env proxy values at runtime;
# run.bat also enables proxy variables inherited from the terminal at startup.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# ── Private / local model (optional) ──────────────────────────────────
# Run everything on your own machine — text never leaves it.
# Point at Ollama / LM Studio / vLLM (any OpenAI-compatible server) and
# turn OFF the reasoning extras, which local servers usually reject.
#
# LLM_BASE_URL=http://localhost:11434/v1   # Ollama
# LLM_API_KEY=ollama                        # any non-empty string
# LLM_MODEL=qwen2.5:14b
# LLM_THINKING_TYPE=off
# LLM_REASONING_EFFORT=off
#
# Note: the AI-smell score is always 100% local — it never calls a model.
